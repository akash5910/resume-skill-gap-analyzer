{
  "name": "skill-gap-member3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npm install --prefix member1/ResumeSkillGapAnalyzer",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "member1": "node member1/ResumeSkillGapAnalyzer/server.js",
    "member2": "node member2/member2/server.js",
    "seed:roles": "node member2/member2/seed/seedJobRoles.js",
    "seed:resources": "node member2/member2/seed/seedLearningResources.js",
    "seed": "npm run seed:roles && npm run seed:resources",
    "prestart": "npm run seed",
    "build": "vite build",
    "start": "concurrently \"npm run server\" \"npm run client\" \"npm run member1\" \"npm run member2\""
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "vite": "^6.0.7"
  }
}
